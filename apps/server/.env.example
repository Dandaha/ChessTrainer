# Copy to .env (same folder) to change a setting. .env is never committed.

# Port of the local API server. It always listens on 127.0.0.1 only.
PORT=3001

# Where the database file lives. Default: apps/server/data/chess.db
# DATABASE_PATH=C:\Users\me\Documents\chess\chess.db

# Personal Lichess token for the opening explorer (repertoire gap finder) and
# faster Lichess imports. Create one at lichess.org/account/oauth/token, no scopes.
# LICHESS_TOKEN=

# Claude API key for the in-app coach (phase 6). Without it the coach stays off.
# ANTHROPIC_API_KEY=
