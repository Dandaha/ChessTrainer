{
  "name": "chess-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @chess/server --filter @chess/web dev",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:migrate": "pnpm --filter @chess/server db:migrate",
    "db:generate": "pnpm --filter @chess/server db:generate"
  }
}
